<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      netstandard2.0: .NET Core 2.0+, .NET 5+, .NET Framework 4.6.1+, Mono 5.4+, Unity, Xamarin.
      net40: older .NET Framework, as shipped by previous releases.
    -->
    <TargetFrameworks>netstandard2.0;net40</TargetFrameworks>
    <!-- Highest C# version supported by all targets, keeps the source compatible with older compilers. -->
    <LangVersion>7.3</LangVersion>
    <RootNamespace>Hsluv</RootNamespace>
    <AssemblyName>Hsluv</AssemblyName>
    <Deterministic>true</Deterministic>

    <PackageId>Hsluv</PackageId>
    <Version>2.0.0</Version>
    <Authors>Alexei Boronine</Authors>
    <Description>Human-friendly HSL</Description>
    <Copyright>Copyright (c) 2015-2026 Alexei Boronine</Copyright>
    <PackageTags>Color ColorSpace HSL Hsluv CIELuv CIELCh</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://www.hsluv.org</PackageProjectUrl>
    <RepositoryUrl>https://github.com/hsluv/hsluv-csharp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
