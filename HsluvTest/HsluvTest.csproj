<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!--
      net8.0/net10.0 exercise the netstandard2.0 build of the library,
      net48 exercises the net40 build.
    -->
    <TargetFrameworks>net8.0;net10.0;net48</TargetFrameworks>
    <LangVersion>7.3</LangVersion>
    <StartupObject>HsluvTest.HsluvConverterTest</StartupObject>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Hsluv\Hsluv.csproj" />
    <EmbeddedResource Include="snapshot-rev4.json" LogicalName="JsonSnapshotRev4" />
  </ItemGroup>

</Project>
